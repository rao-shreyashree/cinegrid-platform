# shravani this file is for ur reference
# you will create a .env and put a password in place of your_password_here
# and that will b gitignored

# The password for LOCAL Docker database
DB_PASSWORD=your_password_here

# Option 1: Connect to our LOCAL Docker database (we use this for development)
DATABASE_URL=postgresql://cinegrid:your_password_here@localhost:5432/cinegrid

# Option 2: shared Neon database (demo). Replace the line above with a string like:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app refuses to start unless this is at least 32 characters
JWT_SECRET=generate_with_command_above

# Optional. Password with both of us when seeding. We need to set a strong one for a shared Neon DB.
# DEMO_PASSWORD=